# Copia este archivo como .env y escribe tus valores. El .env NUNCA se sube al repositorio.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=escribe-aqui-tu-contrasena
POSTGRES_DB=patitas
# Base separada para las pruebas: se puede vaciar sin perder datos reales.
POSTGRES_DB_PRUEBAS=patitas_test
# Solo con Neon u otra base que exija TLS (docs/aprende/migrar-a-neon.md):
# POSTGRES_SSLMODE=require
# Clave para firmar los tokens de sesión (mínimo 32 caracteres). Déjala vacía aquí y en tu
# .env pon una generada con:  python -c "import secrets; print(secrets.token_hex(32))"
PATITAS_JWT_SECRETO=
# Clave para cifrar datos personales (contacto del ciudadano, RNF-08), mínimo 32 caracteres.
# Vacía = el reporte no acepta contacto. Genera una con el mismo comando de arriba.
PATITAS_CLAVE_DATOS=
# Minutos que dura una sesión (1 a 480).
PATITAS_JWT_MINUTOS=30
# Primera cuenta de administración (#67): se crea al arrancar si no existe. Vacías = ninguna.
# La contraseña (mínimo 12 caracteres) se escribe solo en tu .env o en Render, nunca aquí.
PATITAS_ADMIN_CORREO=
PATITAS_ADMIN_CONTRASENA=
# Datos de demostración (#109): true los carga una vez al arrancar. La contraseña de las
# cuentas *@demo.patitas.co (mínimo 12 caracteres) solo en tu .env o en Render.
PATITAS_DEMO_ACTIVA=false
PATITAS_DEMO_CONTRASENA=
# Correo de las alertas (DT-03). Sin PATITAS_SMTP_HOST las alertas solo van al log.
PATITAS_SMTP_HOST=
PATITAS_SMTP_PORT=587
PATITAS_SMTP_USUARIO=
PATITAS_SMTP_CONTRASENA=
PATITAS_SMTP_REMITENTE=
PATITAS_SMTP_STARTTLS=true
# Correos que reciben la alerta de ocupación del 90 % (RN-04), separados por comas.
PATITAS_CORREOS_COORDINADORES=
