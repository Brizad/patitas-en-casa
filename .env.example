# Copia este archivo como .env y escribe tus valores. El .env NUNCA se sube al repositorio.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=escribe-aqui-tu-contrasena
POSTGRES_DB=patitas
# Base separada para las pruebas: se puede vaciar sin perder datos reales.
POSTGRES_DB_PRUEBAS=patitas_test
# Clave para firmar los tokens de sesión (mínimo 32 caracteres). Déjala vacía aquí y en tu
# .env pon una generada con:  python -c "import secrets; print(secrets.token_hex(32))"
PATITAS_JWT_SECRETO=
# Minutos que dura una sesión (1 a 480).
PATITAS_JWT_MINUTOS=30
